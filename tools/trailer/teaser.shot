# The teaser: the tour's run cut to track.mjs (90 BPM, a bar is 8/3 s), calm enough to follow: the plan coming to be,
# the minimap, then the name on the board's own canvas.
#   node tools/trailer/track.mjs build/trailer/track.wav
#   java tools/trailer/Trailer.java tools/trailer/teaser.shot [--stills | --every 0.5]
#
# Times in the edit are seconds or beats (8b = 8 beats). Times in a recording are seconds, or a tour step's start (s20)
# or note (w20), with an offset (s20+1.5). Keys inside a shot are in the shot's own time.

size 1920 1080
fps 60
bpm 90
duration 31.5
source run/client/recordings/tour2
out build/trailer/teaser.mp4
stilldir build/trailer/stills
set audio build/trailer/track.wav
set audiogain -1.8dB

title GTNH Planner
set wordscale 8
set dotstep 40
set dotsize 4

# The whole edit: in from black; every shot leans the same gentle way and dissolves in from the last.
key exposure 0 0
key exposure 0.8 1
set dissolve 0.3
set followsmooth 0.6
set blendframes 0

# Bar 1: NEI, the reactor's recipe, the plan button.
shot 0 4b nei
  remap 0 s2+3.0
  remap 1.4 s2+4.6
  remap 4b s3+1.9
  key roll 0 -2.2
  key roll 4b -1.6
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.5
  key zoom 4b 1.6
  key follow 0 0.5
  key focusfollow 0 0.5
  set dissolve 0
end

# Bars 2-3: the card lands, the tour's note, two drawers dragged out of its ports.
shot 4b 10b card
  remap 0 s3+2.15
  remap 1.3 s3+3.4
  remap 1.7 s4+0.2
  remap 6b s4+3.7
  key roll 0 -2
  key roll 6b -1.4
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.75
  key zoom 6b 1.65
  key cx 0 0.515
  key cy 0 0.5
  key follow 1.6 0
  key follow 2.4 0.4
end

# Bar 4: a rate asked of the acid, and the plan works out the rest.
shot 10b 14b rate
  src s6-0.1 s6+2.5
  key roll 0 -2
  key roll 4b -1.5
  key yaw 0 2
  key pitch 0 1
  key zoom 0 1.7
  key zoom 4b 1.85
  key follow 0 0.5
  key focusfollow 0 0.5
end

# Bars 5-6: R on a drawer, NEI, the distillation tower added and wired.
shot 14b 20b tower
  src s16+0.05 s16+4.85
  key roll 0 -2
  key roll 6b -1.4
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.55
  key zoom 6b 1.65
  key follow 0 0.5
  key focusfollow 0 0.5
end

# Bars 6-7: power: the turbine wired to the tower, drawers for what it makes.
shot 20b 26b power
  src s20+2.0 s20+7.6
  key roll 0 -2
  key roll 6b -1.5
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.5
  key zoom 6b 1.6
  key follow 0 0.45
  key focusfollow 0 0.45
end

# Bar 8: Arrange, at the game's own pace (slowed, the glide doubles up).
shot 26b 30b arrange
  src s21-0.05 s21+2.6
  key roll 0 -2
  key roll 4b -1.5
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.55
  key zoom 1.2 1.6
  key zoom 4b 2.0
  key cx 0 0.5
  key cy 0.8 0.58
  key cy 1.8 0.5
end

# Bar 9: a sticky note added and written on.
shot 30b 34b note
  src s22+0.4 s22+3.6
  key roll 0 -2
  key roll 4b -1.5
  key yaw 0 2.5
  key pitch 0 1
  key zoom 0 1.75
  key zoom 4b 1.85
  key follow 0 0.5
  key focusfollow 0 0.5
end

# Bars 10-11: the minimap over the world (filmed centred, call 'minimap?centre=1'), the tour panning and zooming it.
shot 34b 40b minimap
  source run/client/recordings/minimap
  src 6.3 10.3
  key roll 0 -1.8
  key roll 6b -1.2
  key yaw 0 2
  key pitch 0 1
  key zoom 0 1.55
  key zoom 6b 1.7
  key cx 0 0.5
  key cy 0 0.55
end

# Bar 12 on: the board's canvas, the name.
shot 40b 31.5 end
  source run/client/recordings/minimap
  remap 0 10.3
  remap 4 10.4
  key roll 0 -1.2
  key yaw 0 2
  key pitch 0 1
  key zoom 0 1.7
  key cx 0 0.5
  key cy 0 0.55
  key endbg 0 0
  key endbg 0.9 1
  key endcard 0.5 0
  key endcard 1.7 1
  key master 3.3 1
  key master 4.8 0
  set dissolve 0
end

still 18.6
still 29
